{
  "type": "task",
  "states": {
    "initial": ["pending"],
    "terminal": ["merged", "rejected", "escalated"],
    "all": [
      "pending", "tactical-plan", "implementing", "documenting",
      "council", "final-gate", "merged", "rejected", "escalated"
    ]
  },
  "transitions": [
    { "from": "pending", "to": "tactical-plan", "allowed_actors": ["agent"], "description": "Implementer picks up the Task." },
    { "from": "tactical-plan", "to": "implementing", "allowed_actors": ["agent"], "description": "Tactical plan accepted (plan_review pass, or no plan_review council)." },
    { "from": "tactical-plan", "to": "pending", "allowed_actors": ["human", "agent"], "gate": "per_task_plan_review", "description": "Per-Task Plan Review rejected. Human by default; agent-driven when a decisive plan_review council is bound." },
    { "from": "implementing", "to": "documenting", "allowed_actors": ["agent"] },
    { "from": "documenting", "to": "council", "allowed_actors": ["agent"], "description": "Enter the delivery council phase." },
    { "from": "council", "to": "final-gate", "allowed_actors": ["agent"], "description": "Council passed. Carries security_review_verdict='pass' backstop for high-security tasks." },
    { "from": "council", "to": "implementing", "allowed_actors": ["agent"], "description": "Council bounced; back to the Implementer (batched feedback)." },
    { "from": "council", "to": "escalated", "allowed_actors": ["agent", "human"], "description": "Council escalated (hard blocker; un-lowerable)." },
    { "from": "final-gate", "to": "merged", "allowed_actors": ["human"], "gate": "final_approval_gate", "description": "Single human approval before merge." },
    { "from": "final-gate", "to": "rejected", "allowed_actors": ["human"], "gate": "final_approval_gate" },
    { "from": "pending", "to": "escalated", "allowed_actors": ["agent", "human"] },
    { "from": "tactical-plan", "to": "escalated", "allowed_actors": ["agent", "human"] },
    { "from": "implementing", "to": "escalated", "allowed_actors": ["agent", "human"] },
    { "from": "documenting", "to": "escalated", "allowed_actors": ["agent", "human"] },
    { "from": "final-gate", "to": "escalated", "allowed_actors": ["human"] }
  ]
}
